{
    "compilerOptions": {
      "module": "ESNext",
      "target": "ES2022",
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "moduleResolution": "bundler",
      "resolveJsonModule": true,
      "noEmit": true,
      "isolatedModules": true,
      "verbatimModuleSyntax": true,
      "forceConsistentCasingInFileNames": true,
      "types": [],
      "strict": true
    },
    "include": ["src/**/*.ts"]
  }
