{
  "name": "htmlgame",
  "version": "1.0.0",
  "description": "A browser platformer built with TypeScript and Canvas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "vite",
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:browser": "npm run build && playwright test",
    "check": "npm test && npm run build",
    "level": "node scripts/levels.cjs",
    "level:audit": "node --test tests/level-audit.test.cjs",
    "typecheck": "tsc --noEmit"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@blacklight/signal-soul": "file:vendor/blacklight-signal-soul-2.0.0-beta.1.tgz",
    "lit": "^3.3.3"
  }
}
